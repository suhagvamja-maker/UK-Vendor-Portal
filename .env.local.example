# =====================================================================
# Copy this file to .env.local and fill in values. NEVER commit .env.local.
# =====================================================================

# ---- Clerk (required) ----------------------------------------------------
# Get these from https://dashboard.clerk.com  →  your app  →  "API Keys"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk-hosted UI paths (defaults work; rarely changed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Owner bootstrap (required) -----------------------------------------
# The FIRST user who signs up with this email becomes the system owner
# (full Admin + the only person who can invite Admin/Finance teammates).
OWNER_EMAIL=suhag.vamja@gokwik.co

# ---- App ----------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# ---- Supabase (only needed when moving to production database) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLERK_JWT_TEMPLATE=supabase

# ---- Resend (only needed to send real email) ----------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Inngest (only needed in production for async background jobs) ------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
